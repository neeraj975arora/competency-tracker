# Copy this file to .env and fill it in. Never commit .env.

# Required. Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value

# Only emails ending in this domain can have accounts.
ALLOWED_EMAIL_DOMAIN=impressico.com

# How long a sign-in lasts, in hours.
TOKEN_HOURS=8

# Set to 1 when the site is reached over https (for example a tunnel link).
COOKIE_SECURE=0
